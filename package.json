{
  "name": "marqueslab-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "db:check": "node scripts/check-migrations.mjs",
    "db:seed": "node scripts/generate-seed.mts",
    "cleanup:orphans": "node --env-file=.env.local scripts/cleanup-orphans.mjs",
    "seed:remote": "node --env-file=.env.local scripts/seed-remote.mts",
    "verify:supabase": "node --env-file=.env.local scripts/verify-supabase.mjs"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.6",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "clsx": "^2.1.1",
    "framer-motion": "^14.13.0",
    "gsap": "^3.15.1",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "server-only": "^0.0.1",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "postcss": "^8.5.32",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
