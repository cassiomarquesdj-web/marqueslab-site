# Copie para .env.local e preencha. Nunca commite valores reais.

# URL pública do site (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://marqueslab.com.br

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SOMENTE SERVIDOR (nunca use o prefixo NEXT_PUBLIC_). Necessária para:
# receber orçamentos (/api/leads), enviar anexos e convidar usuários.
SUPABASE_SERVICE_ROLE_KEY=

# Valores padrão de contato (o painel, em Configurações, tem prioridade)
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=
